# Copy this file to .env and fill in real values as you get them.
# .env is gitignored — never commit real credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./ordermate.db

# --- WhatsApp Cloud API ---
# Leave blank to run in DRY_RUN mode (see README "Running without WhatsApp access yet").
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=ordermate_verify_me

# --- OpenAI (optional — rule-based fallback is used if blank) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Alerts ---
# Where low-rating alerts, human-handoff requests, and the weekly digest get sent.
OWNER_WHATSAPP_NUMBER=

# --- Feedback timing ---
# 3 hours in production. Set to something short (e.g. 10) while developing
# locally so you don't have to wait to see the feedback loop fire.
FEEDBACK_DELAY_SECONDS=10800

# --- Abandoned order recovery ---
# How long (seconds) a customer can go quiet mid-order before we nudge them.
# 15 minutes in production; set short (e.g. 10) locally to see it fire quickly.
ABANDONED_ORDER_NUDGE_SECONDS=900

# --- Typing indicator ---
# Deliberate pause (seconds) showing "typing..." before the bot replies — purely
# cosmetic. 0 disables the pause (indicator still fires, no added delay).
TYPING_DELAY_SECONDS=1

# --- Owner weekly digest ---
# Day (mon/tue/.../sun) and hour (server local time, 24h) the weekly summary
# is sent to OWNER_WHATSAPP_NUMBER.
WEEKLY_DIGEST_DAY=mon
WEEKLY_DIGEST_HOUR=8

# --- Admin dashboard (/admin/orders) ---
# Protects a page showing customer names, phone numbers, and delivery
# addresses — leave blank to disable the dashboard entirely (503), never
# silently open. Set both to enable it, over HTTPS only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
